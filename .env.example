# Supabase project (same project both frontends use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Prisma database connection (same Supabase Postgres instance).
# DATABASE_URL goes through the pgbouncer pooler; DIRECT_URL bypasses it and
# is required for Prisma's contract/migration commands.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/mydb"

# Server
PORT=4000

# Optional local stdio MCP process. Supply a short-lived Supabase access token
# for the account this MCP process should act as. Do not commit a real token.
MCP_ACCESS_TOKEN=

# Data retention. The purge runs at startup and daily only when
# RETENTION_ENABLED=true. 0 disables an individual rule. Agent runs, steps and
# approvals are never auto-deleted (they are the audit trail).
RETENTION_ENABLED=false
MEMORY_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730
CONVERSATION_RETENTION_DAYS=365

# Storage bucket for uploaded knowledge-base files (created by
# migrations/0007_knowledge_documents_storage.sql). Optional — defaults to
# "knowledge-documents" if unset.
KNOWLEDGE_STORAGE_BUCKET=knowledge-documents

# Redis — backs rate limiting (middleware/rate-limit.ts) and LLM response
# caching (lib/llm/gateway.ts). Outside Docker, point this at a local Redis
# (e.g. `docker run -p 6379:6379 redis:alpine`); inside docker-compose.yml
# it's set to redis://redis:6379 automatically. Missing/unreachable Redis
# fails open — rate limiting and caching are just disabled, not fatal.
REDIS_URL=redis://localhost:6379

# RabbitMQ message bus: customer-app tickets/tasks, agent runs and approvals are
# published here and relayed to the console's Scheduler. In Docker Compose it is
# set to amqp://rabbitmq:5672 automatically. Unset/unreachable fails open:
# events go straight to the console, just without a queue in between.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Comma-separated list of origins allowed to call this API
# (resolv-hq dev server, resolv-hq-customer/Expo dev server, production domains)
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8081,http://localhost:8083

# --- docker-compose.yml only ---
# `docker compose up` in this directory builds the admin app's image too, and
# only reads .env from THIS directory — these are its build-time args, not
# used when running the app outside Docker (it has its own .env file for
# that). Same Supabase project as above, just under the app's own
# public-facing env var names (VITE_*; the old NEXT_PUBLIC_* names still work).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Host-reachable backend URL baked into the admin app's browser bundle.
# Override only if you're not exposing the backend on localhost:3001 (e.g.
# a real domain in production).
ADMIN_PUBLIC_API_BASE_URL=http://localhost:3001
