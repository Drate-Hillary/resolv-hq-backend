# Supabase project (same project both frontends use)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Server
PORT=4000

# Storage bucket for uploaded knowledge-base files (created by
# migrations/0007_knowledge_documents_storage.sql). Optional — defaults to
# "knowledge-documents" if unset.
KNOWLEDGE_STORAGE_BUCKET=knowledge-documents

# Redis — backs rate limiting (middleware/rate-limit.ts) and LLM response
# caching (lib/llm/gateway.ts). Outside Docker, point this at a local Redis
# (e.g. `docker run -p 6379:6379 redis:alpine`); inside docker-compose.yml
# it's set to redis://redis:6379 automatically. Missing/unreachable Redis
# fails open — rate limiting and caching are just disabled, not fatal.
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call this API
# (resolv-hq dev server, resolv-hq-customer/Expo dev server, production domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# --- docker-compose.yml only ---
# `docker compose up` in this directory builds the admin app's image too, and
# only reads .env from THIS directory — these are its build-time args, not
# used when running the app outside Docker (it has its own .env file for
# that). Same Supabase project as above, just under the app's own
# public-facing env var names.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Host-reachable backend URL baked into the admin app's browser bundle.
# Override only if you're not exposing the backend on localhost:4000 (e.g.
# a real domain in production).
ADMIN_PUBLIC_API_BASE_URL=http://localhost:4000
